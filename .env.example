# Copy to .env and fill in. .env is not committed.
# Python scripts (benchmark.py, gemini_evaluate.py, model_metadata.py, export_json.py, results.py)
# and the PHP pages (config.php) read it from the project directory.

# MySQL
# PHP on the database server usually uses localhost; scripts run from another machine use its IP
DB_HOST=localhost
DB_PORT=3306
DB_USER=llm_benchmark
DB_PASSWORD=change-me
DB_NAME=llm_benchmark

# Evaluator whose scores the PHP pages show (optional)
ACTIVE_EVALUATOR=anthropic/claude-haiku-5-5

# Google Gemini
GEMINI_API_KEY=

# Evaluator configuration (gemini or openai-compatible)
EVALUATOR_TYPE=gemini
EVAL_BASE_URL=
EVAL_MODEL=
EVAL_API_KEY=
